:root {
  --bg: #071a2a;
  --bg-alt: #0d243f;
  --panel: rgba(15, 30, 52, 0.8);
  --panel-border: rgba(147, 197, 253, 0.18);
  --text: #eaf2ff;
  --muted: #bfd3ee;
  --accent: #7dd3fc;
  --accent-strong: #38bdf8;
  --shadow: 0 18px 50px rgba(2, 6, 23, 0.35);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top, rgba(56, 189, 248, 0.18), transparent 30%),
    linear-gradient(135deg, #071a2a 0%, #0b1f33 45%, #102a43 100%);
  color: var(--text);
}

button,
input {
  font: inherit;
}

.app-shell {
  max-width: 1100px;
  margin: 0 auto;
  padding: 32px 20px 48px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 26px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 52px;
  height: 52px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(125, 211, 252, 0.25), rgba(59, 130, 246, 0.22));
  font-size: 1.8rem;
}

.eyebrow {
  margin: 0 0 4px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.7rem;
  color: var(--muted);
}

h1 {
  margin: 0;
  font-size: clamp(1.5rem, 2vw, 2.2rem);
}

.search-form {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 8px 8px 16px;
  border: 1px solid var(--panel-border);
  border-radius: 999px;
  background: rgba(9, 16, 27, 0.3);
  min-width: min(100%, 420px);
}

.search-form input {
  flex: 1;
  border: none;
  background: transparent;
  color: var(--text);
  font-size: 1rem;
  outline: none;
}

.search-form input::placeholder {
  color: rgba(191, 211, 238, 0.8);
}

.search-form button {
  border: none;
  border-radius: 999px;
  padding: 12px 18px;
  background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  color: #062033;
  font-weight: 700;
  cursor: pointer;
}

.dashboard {
  display: grid;
  gap: 22px;
}

.card {
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: 24px;
  box-shadow: var(--shadow);
  backdrop-filter: blur(12px);
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 28px;
}

.location-name {
  margin: 0 0 8px;
  font-size: 1.1rem;
  color: var(--muted);
}

.current-temp {
  margin: 0;
  font-size: clamp(3rem, 7vw, 5.5rem);
  line-height: 1;
}

.weather-summary {
  margin: 12px 0 0;
  font-size: 1.05rem;
  color: var(--muted);
}

.hero-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(100px, 1fr));
  gap: 16px;
  min-width: min(100%, 320px);
}

.hero-meta div {
  padding: 16px 18px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.hero-meta span,
.label {
  display: block;
  margin-bottom: 8px;
  font-size: 0.8rem;
  color: var(--muted);
}

.hero-meta strong,
.metric strong {
  font-size: 1.25rem;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(120px, 1fr));
  gap: 18px;
}

.metric {
  padding: 18px 20px;
}

.forecast-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(100px, 1fr));
  gap: 14px;
  padding: 18px;
}

.hour-card {
  padding: 18px 12px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid rgba(255, 255, 255, 0.06);
  text-align: center;
}

.hour-card .time,
.day-name {
  color: var(--muted);
}

.hour-card .symbol {
  display: block;
  margin: 10px 0;
  font-size: 2rem;
}

.daily-list {
  display: grid;
  gap: 10px;
  padding: 18px;
}

.day-row {
  display: grid;
  grid-template-columns: 100px 50px minmax(120px, 1fr) 80px;
  align-items: center;
  gap: 12px;
  padding: 12px 10px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid rgba(255, 255, 255, 0.04);
}

.day-icon {
  font-size: 1.5rem;
}

.day-summary {
  color: var(--muted);
}

.day-temps {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  font-weight: 600;
}

.low {
  color: var(--muted);
}

.empty-state {
  margin: 0;
  color: var(--muted);
}

@media (max-width: 760px) {
  .topbar,
  .hero {
    flex-direction: column;
    align-items: stretch;
  }

  .search-form {
    min-width: 100%;
  }

  .hero-meta,
  .stats-grid,
  .forecast-row {
    grid-template-columns: repeat(2, minmax(120px, 1fr));
  }

  .day-row {
    grid-template-columns: 80px 40px minmax(90px, 1fr) 70px;
  }
}

@media (max-width: 480px) {
  .hero-meta,
  .stats-grid,
  .forecast-row {
    grid-template-columns: 1fr;
  }
}

